*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# FVM Version Cache
.fvm/

# Python bytecode caches next to the assignment sources
__pycache__/

# Generated code. Rebuilt with `fvm dart run build_runner build`, and the l10n
# output by `flutter build` itself (pubspec's `generate: true`), so a fresh
# clone needs one build_runner run before it compiles.
*.g.dart
*.gr.dart
*.tailor.dart
*.freezed.dart
lib/l10n/generated/

