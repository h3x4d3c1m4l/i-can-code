# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# FVM Version Cache
.fvm/

# Python bytecode caches next to the assignment sources
__pycache__/

# Cargo build output.
rust/target/

# Upstream release artifact, fetched by `just fetch-microbit-firmware`.
assets/microbit/*.hex

# Everything the Rust core generates. CI builds it, so none of it is committed;
# see docs/rust-core-build.md.
lib/src/rust/**/*.dart
rust/src/frb_generated.rs
web/pkg/

# Generated code. Rebuilt with `fvm dart run build_runner build`, and the l10n
# output by `flutter build` itself (pubspec's `generate: true`), so a fresh
# clone needs one build_runner run before it compiles.
*.g.dart
*.gr.dart
*.tailor.dart
*.freezed.dart
lib/l10n/generated/


# The Tkinter VM's build output and the image bundle the page loads. Both are
# built or fetched locally and ship as a release asset, not in the repository.
vm/build/
web/vm/image/

# The VM tools' npm packages; vm/tools/package-lock.json pins them.
vm/tools/node_modules/

# The guest agent's Cargo build output. The image build compiles it in Docker.
vm/agent/target/
